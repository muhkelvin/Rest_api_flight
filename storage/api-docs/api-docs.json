    "components": {
        "schemas": {
            "User": {
                "required": [
                    "name",
                    "email"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "preferences": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UserRegister": {
                "required": [
                    "name",
                    "email",
                    "password"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "UserLogin": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "1|abcdef123456"
                    }
                },
                "type": "object"
            },
            "UserProfile": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "preferences": {
                        "type": "string",
                        "example": "Window Seat",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Airline": {
                "required": [
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Garuda Indonesia"
                    },
                    "description": {
                        "type": "string",
                        "example": "National Flag Carrier"
                    },
                    "class": {
                        "type": "string",
                        "example": "Business"
                    }
                },
                "type": "object"
            },
            "AirlineRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Garuda Indonesia"
                    },
                    "description": {
                        "type": "string",
                        "example": "National Flag Carrier"
                    },
                    "class": {
                        "type": "string",
                        "example": "Business"
                    }
                },
                "type": "object"
            },
            "Flight": {
                "required": [
                    "destination_id",
                    "airline_id",
                    "departure_time"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "destination_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "airline_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "departure_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-20 08:00:00"
                    },
                    "arrival_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-20 10:00:00"
                    },
                    "direct_flight": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "FlightRequest": {
                "required": [
                    "destination_id",
                    "airline_id",
                    "departure_time"
                ],
                "properties": {
                    "destination_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "airline_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "departure_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-20 08:00:00"
                    },
                    "arrival_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-20 10:00:00"
                    },
                    "direct_flight": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Destination": {
                "required": [
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Paris"
                    },
                    "description": {
                        "type": "string",
                        "example": "City of Light"
                    }
                },
                "type": "object"
            },
            "DestinationRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Paris"
                    },
                    "description": {
                        "type": "string",
                        "example": "City of Light"
                    }
                },
                "type": "object"
            },
            "Booking": {
                "required": [
                    "flight_id"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "flight_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-19 15:00:00"
                    }
                },
                "type": "object"
            },
            "BookingRequest": {
                "required": [
                    "flight_id"
                ],
                "properties": {
                    "flight_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    }
                },
                "type": "object"
            },
            "Payment": {
                "required": [
                    "user_id",
                    "flight_id",
                    "amount"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "flight_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 250.5
                    },
                    "status": {
                        "type": "string",
                        "example": "pending"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2024-03-19 15:30:00"
                    }
                },
                "type": "object"
            },
            "PaymentRequest": {
                "required": [
                    "flight_id",
                    "amount"
                ],
                "properties": {
                    "flight_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "amount": {
                        "type": "number",
                        "format": "float",
                        "example": 500.75
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            },
            "adminAuth": {
                "type": "apiKey",
                "name": "X-Admin-Key",
                "in": "header"
            }
        }
